{
  "name": "storyboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prompt-driven storyboard videos for web projects. Each scene is an animated HTML composition written by Claude with access to your codebase.",
  "bin": {
    "story": "./bin/story.mjs"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore 'projects/**' --ignore 'src/**' server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/ms-madi": "^5.3.0",
    "express": "^5.2.1",
    "gsap": "^3.15.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.49.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/pngjs": "^6.0.5",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
